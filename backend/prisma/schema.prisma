// LocalLoop Database Schema
// PostgreSQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USER & AUTH
// ============================================

enum UserRole {
  STUDENT
  PROFESSIONAL
  INTERN
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ReputationLevel {
  EXPLORER
  GUIDE
  SETTLER
  CITY_NAVIGATOR
  LOCAL_MENTOR
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id              String   @id @default(cuid())
  email           String?  @unique
  password        String
  name            String
  avatar          String?
  role            UserRole  @default(STUDENT)
  gender          Gender?
  city            String?
  preferredArea   String?
  moveMonth       String?
  budgetMin       Int?
  budgetMax       Int?
  isWomenMode     Boolean   @default(false)
  isOnboarded     Boolean   @default(false)
  isMentor        Boolean  @default(false)
  bio             String?
  phone           String?  @unique
  university      String?
  company         String?
  isVerified      Boolean   @default(false)
  inviteCode      String?  @unique
  invitedBy       String?
  referralCode    String?  @unique
  preferences     Json?
  welcomeEmailSent Boolean  @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // ── ML-Ready Extended Profile Fields ──
  interests       String[]           // hobbies/interests for friend matching
  foodPreference  String?            // veg, non-veg, vegan, eggetarian
  workSchedule    String?            // morning, day, night, flexible
  languages       String[]           // spoken languages
  lifestyle       String?            // early_bird, night_owl, social, introvert
  transportMode   String?            // own_vehicle, public, walking, cab
  smoking         String?            // yes, no, occasionally
  drinking        String?            // yes, no, occasionally
  petFriendly     Boolean?
  ageRange        String?            // 18-22, 23-27, 28-32, 33+
  hometown        String?            // for hometown community matching
  courseOrDept    String?            // course/department for student matching
  monthlyIncome   String?            // income bracket for expense prediction

  // ── Verification Fields ──
  verificationStatus VerificationStatus @default(UNVERIFIED)
  idProofUrl      String?            // uploaded ID proof file URL
  idProofType     String?            // aadhaar, pan, passport, college_id
  verificationNotes String?          // admin notes on verification
  verifiedAt      DateTime?
  verifiedBy      String?            // admin user ID who verified

  // Relations
  housings        Housing[]
  housingReviews  HousingReview[]
  savedHousings   SavedHousing[]
  communities     CommunityMember[]
  posts           Post[]
  comments        Comment[]
  sentMessages    Message[]     @relation("SentMessages")
  receivedMessages Message[]    @relation("ReceivedMessages")
  reputation      Reputation?
  createdEvents   Event[]
  eventAttendees  EventAttendee[]
  mentorProfile   MentorProfile?
  communityMessages CommunityMessage[]
  bookings        HousingBooking[]
  mentorships     Mentorship[]      @relation("Mentee")
  mentoring       Mentorship[]      @relation("Mentor")
  createdPolls    CommunityPoll[]
  pollVotes       PollVote[]
  chatMessages    ChatMessage[]
  housingViews    HousingView[]

  @@map("users")
}

model Reputation {
  id        String          @id @default(cuid())
  userId    String          @unique
  points    Int             @default(0)
  level     ReputationLevel @default(EXPLORER)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reputations")
}

model MentorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  expertise       String[]
  experience      String?
  availability    String?
  isApproved      Boolean  @default(false)
  menteeCount     Int      @default(0)
  maxMentees      Int      @default(3)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mentor_profiles")
}

// ============================================
// HOUSING
// ============================================

enum HousingType {
  PG
  HOSTEL
  FLAT
  SHARED_ROOM
  SINGLE_ROOM
}

enum GenderPreference {
  MALE_ONLY
  FEMALE_ONLY
  CO_ED
  ANY
}

model Housing {
  id                String           @id @default(cuid())
  title             String
  description       String
  address           String
  area              String
  city              String           @default("Pune")
  rent              Int
  deposit           Int?
  type              HousingType
  genderPreference  GenderPreference @default(ANY)
  amenities         String[]
  images            String[]
  isVerified        Boolean          @default(false)
  isWomenFriendly   Boolean          @default(false)
  safetyRating      Float?
  contactPhone      String?
  contactEmail      String?
  latitude          Float?
  longitude         Float?
  availableFrom     DateTime?
  createdById       String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relations
  createdBy         User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  reviews           HousingReview[]
  savedBy           SavedHousing[]
  bookings          HousingBooking[]
  views             HousingView[]

  @@index([city, area])
  @@index([rent])
  @@index([type])
  @@map("housings")
}

model HousingReview {
  id          String   @id @default(cuid())
  rating      Int      // 1-5
  review      String
  userId      String
  housingId   String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  housing     Housing  @relation(fields: [housingId], references: [id], onDelete: Cascade)

  @@unique([userId, housingId])
  @@map("housing_reviews")
}

model SavedHousing {
  id          String   @id @default(cuid())
  userId      String
  housingId   String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  housing     Housing  @relation(fields: [housingId], references: [id], onDelete: Cascade)

  @@unique([userId, housingId])
  @@map("saved_housings")
}

// ============================================
// COMMUNITIES
// ============================================

enum CommunityType {
  UNIVERSITY
  PROFESSIONAL
  HOMETOWN
  NEWCOMER_BATCH
  WOMEN_ONLY
  GENERAL
}

enum MemberRole {
  MEMBER
  MODERATOR
  ADMIN
}

model Community {
  id          String         @id @default(cuid())
  name        String
  description String?
  type        CommunityType
  city        String         @default("Pune")
  avatar      String?
  coverImage  String?
  isPrivate   Boolean        @default(false)
  isWomenOnly Boolean        @default(false)
  memberCount Int            @default(0)
  isVerified  Boolean        @default(false)
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  members     CommunityMember[]
  posts       Post[]
  events      Event[]
  communityMessages CommunityMessage[]
  polls       CommunityPoll[]

  @@index([city, type])
  @@map("communities")
}

model CommunityMember {
  id            String     @id @default(cuid())
  userId        String
  communityId   String
  role          MemberRole @default(MEMBER)
  joinedAt      DateTime   @default(now())

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  community     Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@map("community_members")
}

model CommunityPoll {
  id          String      @id @default(cuid())
  question    String
  options     Json        // Array of string options
  communityId String
  createdById String
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())

  // Relations
  community   Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  votes       PollVote[]

  @@map("community_polls")
}

model PollVote {
  id          String        @id @default(cuid())
  pollId      String
  userId      String
  optionIndex Int           // The index of the option in CommunityPoll.options

  poll        CommunityPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId]) // 1 vote per user per poll
  @@map("poll_votes")
}

// ============================================
// POSTS & COMMENTS
// ============================================

model Post {
  id            String    @id @default(cuid())
  content       String
  images        String[]
  communityId   String
  userId        String
  likesCount    Int       @default(0)
  commentsCount Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  community     Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments      Comment[]

  @@index([communityId])
  @@map("posts")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comments")
}

// ============================================
// MESSAGING
// ============================================

model Message {
  id          String   @id @default(cuid())
  content     String
  senderId    String
  receiverId  String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@map("messages")
}

// ============================================
// EVENTS
// ============================================

enum EventType {
  MEETUP
  STUDY_GROUP
  NETWORKING
  CITY_EXPLORATION
  WORKSHOP
  WELCOME
}

model Event {
  id            String      @id @default(cuid())
  title         String
  description   String
  type          EventType
  date          DateTime
  endDate       DateTime?
  location      String
  maxAttendees  Int?
  communityId   String?
  createdById   String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  community     Community?  @relation(fields: [communityId], references: [id], onDelete: SetNull)
  createdBy     User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  attendees     EventAttendee[]

  @@map("events")
}

model EventAttendee {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("event_attendees")
}

// ============================================
// COMMUNITY MESSAGES (Group Chat)
// ============================================

model CommunityMessage {
  id            String    @id @default(cuid())
  content       String
  communityId   String
  userId        String
  createdAt     DateTime  @default(now())

  community     Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt])
  @@map("community_messages")
}

// ════════════ HOUSING BOOKINGS ════════════

model HousingBooking {
  id          String   @id @default(cuid())
  status      BookingStatus @default(PENDING)
  moveInDate  DateTime
  months      Int      @default(1)
  visitDate   DateTime?
  message     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  housing     Housing  @relation(fields: [housingId], references: [id], onDelete: Cascade)
  housingId   String

  @@map("housing_bookings")
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ════════════ MENTORSHIPS ════════════

model Mentorship {
  id          String   @id @default(cuid())
  status      MentorshipStatus @default(PENDING)
  message     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mentee      User     @relation("Mentee", fields: [menteeId], references: [id], onDelete: Cascade)
  menteeId    String
  mentor      User     @relation("Mentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentorId    String

  @@map("mentorships")
}

enum MentorshipStatus {
  PENDING
  ACTIVE
  COMPLETED
  DECLINED
}

// ============================================
// AI / ML DATA
// ============================================

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String   // "user" or "assistant"
  content   String
  metadata  Json?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_chat_messages")
}

model HousingView {
  id        String   @id @default(cuid())
  userId    String
  housingId String
  viewedAt  DateTime @default(now())
  duration  Int?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  housing   Housing  @relation(fields: [housingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([housingId])
  @@map("housing_views")
}
