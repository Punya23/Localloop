# ===========================================
# DATABASE (Supabase PostgreSQL)
# ===========================================
# Go to supabase.com → Your Project → Connect → ORMs → Prisma
# Transaction Pooler (port 6543) — used by the running app
DATABASE_URL="postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres"
# Session Pooler (port 5432) — used by Prisma migrations
DIRECT_URL="postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# ===========================================
# JWT AUTH
# ===========================================
JWT_SECRET="your-secure-random-secret-key"
JWT_EXPIRATION="7d"

# ===========================================
# APP
# ===========================================
PORT=3001
NODE_ENV=development

# ===========================================
# CLOUDINARY (for image uploads)
# ===========================================
# Go to cloudinary.com → Dashboard to get these values
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ===========================================
# FRONTEND URL
# ===========================================
FRONTEND_URL="http://localhost:3000"

# ===========================================
# AI / LLM (Cerebras — OpenAI-compatible)
# ===========================================
CEREBRAS_API_KEY="your-cerebras-api-key"
CEREBRAS_BASE_URL="https://api.cerebras.ai/v1"
CEREBRAS_MODEL="llama3.1-8b"

# ===========================================
# REDIS (optional — L2 cache tier, OFF by default)
# ===========================================
# The API always runs an in-process L1 cache; Redis is a second, shared tier.
# Leave this unset (or pointed at localhost) for a single-instance deployment —
# it stays disabled and the app runs on L1 alone. Set it to a real host once you
# run more than one API instance, which is when per-process caches start
# disagreeing with each other. REDIS_ENABLED=true forces it on against a local
# Redis for testing.
# REDIS_URL="redis://localhost:6379"
# REDIS_ENABLED=false
